<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_item_focus"
    android:padding="16dp"
    android:focusable="false"
    android:clickable="false">

    <!-- Actions Container on Right -->
    <LinearLayout
        android:id="@+id/ll_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_addon_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:focusable="true"
            android:clickable="true"
            android:checked="true"/>

        <ImageButton
            android:id="@+id/btn_up"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:src="@android:drawable/arrow_up_float"
            app:tint="#FFFFFF"
            android:background="@drawable/bg_icon_button_focus"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Move Up"/>

        <ImageButton
            android:id="@+id/btn_down"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:src="@android:drawable/arrow_down_float"
            app:tint="#FFFFFF"
            android:background="@drawable/bg_icon_button_focus"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Move Down"/>

        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#4CAF50"
            android:background="@drawable/bg_icon_button_focus"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Edit Addon"/>

        <ImageButton
            android:id="@+id/btn_remove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#FF5555"
            android:background="@drawable/bg_icon_button_focus"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Remove Addon"/>
    </LinearLayout>

    <!-- Information Column on Left -->
    <TextView
        android:id="@+id/tv_addon_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ll_actions"
        android:layout_marginEnd="16dp"/>

    <TextView
        android:id="@+id/tv_addon_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/tv_addon_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ll_actions"
        android:layout_marginEnd="16dp"/>

    <TextView
        android:id="@+id/tv_addon_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E50914"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="#33E50914"
        app:layout_constraintTop_toBottomOf="@id/tv_addon_desc"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
