<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TMDB Integration Settings"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- API Key Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TMDB API Key (Optional)"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/input_tmdb_api_key"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_item_focus"
            android:paddingHorizontal="12dp"
            android:textColor="#FFFFFF"
            android:hint="Enter API Key"
            android:textColorHint="#55FFFFFF"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <!-- Checkboxes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable Features"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <CheckBox
            android:id="@+id/check_tmdb_ratings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Fetch Media Ratings"
            android:textColor="#FFFFFF"
            android:buttonTint="#E50914"
            android:layout_marginBottom="4dp"/>

        <CheckBox
            android:id="@+id/check_tmdb_plot"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Fetch Plot / Descriptions"
            android:textColor="#FFFFFF"
            android:buttonTint="#E50914"
            android:layout_marginBottom="4dp"/>

        <CheckBox
            android:id="@+id/check_tmdb_genres"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Fetch Genres"
            android:textColor="#FFFFFF"
            android:buttonTint="#E50914"
            android:layout_marginBottom="4dp"/>

        <CheckBox
            android:id="@+id/check_tmdb_cast"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Fetch Cast Members"
            android:textColor="#FFFFFF"
            android:buttonTint="#E50914"
            android:layout_marginBottom="4dp"/>

        <CheckBox
            android:id="@+id/check_tmdb_backdrops"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Fetch High-Quality Posters/Backdrops"
            android:textColor="#FFFFFF"
            android:buttonTint="#E50914"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="16dp"/>


        <!-- Vote Count Threshold Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vote Count Thresholds"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btn_tmdb_filter_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vote Count Thresholds by Region"
            android:textColor="#FFFFFF"
            android:backgroundTint="#21262D"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp"
            android:padding="12dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_vote_count_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tier 1: 100 votes | Tier 2: 20 votes"
            android:textColor="#8B949E"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>
</ScrollView>
