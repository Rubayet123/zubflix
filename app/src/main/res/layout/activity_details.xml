<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08090C">

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:indeterminateTint="#E50914"
        android:elevation="10dp" />

    <!-- Floating Top-Left Back Button -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_circle_action_btn"
        android:src="@drawable/ic_arrow_back"
        android:padding="11dp"
        android:scaleType="centerInside"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:elevation="12dp"
        android:contentDescription="Back" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Hero Header Container with Backdrop & Fade Gradient -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Backdrop Image -->
                <ImageView
                    android:id="@+id/img_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="460dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_smart_poster"
                    android:contentDescription="Backdrop Artwork" />

                <!-- Top Shadow Gradient -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/top_bar_gradient" />

                <!-- Deep Dark Fade Gradient -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="460dp"
                    android:background="@drawable/bg_hero_gradient_deep" />

                <!-- Content Overlaid at the Bottom of Backdrop -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/img_backdrop"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="12dp">

                    <!-- Movie / Series Title -->
                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Movie Title"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginBottom="8dp" />

                    <!-- Metadata Badges Row (★ Rating, Year, Source) - Placed below Title -->
                    <LinearLayout
                        android:id="@+id/meta_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <!-- Rating Pill -->
                        <TextView
                            android:id="@+id/tv_match"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_hero_rating_pill"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="3dp"
                            tools:text="★ 7.5"
                            android:textColor="#FFD700"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <!-- Year Pill -->
                        <TextView
                            android:id="@+id/tv_year"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_meta_pill_dark"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="3dp"
                            tools:text="2026"
                            android:textColor="#E0E6F0"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <!-- Provider / Source Pill -->
                        <TextView
                            android:id="@+id/tv_provider"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_meta_pill_dark"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="3dp"
                            tools:text="Nuvio"
                            android:textColor="#9EADC4"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Dynamic Genre Pill Badges Row -->
                    <HorizontalScrollView
                        android:id="@+id/scroll_genres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:id="@+id/genres_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <!-- Overview / Description -->
                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Overview text..."
                        android:textColor="#C0CCDC"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.25"
                        android:maxLines="4"
                        android:ellipsize="end"
                        android:layout_marginBottom="16dp" />

                    <!-- Action Buttons Row (Watch Movie, Search, Heart/My List) -->
                    <LinearLayout
                        android:id="@+id/action_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <!-- Primary CTA Button (Solid Red Pill) -->
                        <LinearLayout
                            android:id="@+id/btn_play"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_btn_watch_movie"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:id="@+id/iv_play_icon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_play_premium"
                                app:tint="#FFFFFF"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tv_play_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WATCH MOVIE"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.04" />
                        </LinearLayout>

                        <!-- Search Other Sources Circular Button -->
                        <FrameLayout
                            android:id="@+id/btn_search_sources"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_circle_action_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_search"
                                app:tint="#FFFFFF"
                                android:contentDescription="Search other sources" />
                        </FrameLayout>

                        <!-- My List Favorite Heart Circular Button -->
                        <FrameLayout
                            android:id="@+id/btn_my_list"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_circle_action_btn"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/iv_my_list_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_heart_outline"
                                app:tint="#FFFFFF"
                                android:contentDescription="Favorite My List" />
                        </FrameLayout>

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>

            <!-- Series Section: Season Selector -->
            <LinearLayout
                android:id="@+id/layout_seasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_seasons_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT SEASON"
                    android:textColor="#8896A8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_seasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:scrollbars="none" />

            </LinearLayout>

            <!-- Series Section: Episodes List -->
            <LinearLayout
                android:id="@+id/layout_episodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="20dp"
                android:visibility="gone">

                <!-- Header with Red Accent Bar & Episode Count -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_alignParentStart="true">

                        <!-- Red Accent Bar -->
                        <View
                            android:layout_width="3dp"
                            android:layout_height="16dp"
                            android:background="#E50914"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tv_episodes_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SEASON 1 EPISODES"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_episodes_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="8 EPISODES"
                        android:textColor="#8896A8"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="none" />

            </LinearLayout>

            <!-- Cast & Crew Horizontal Slider -->
            <LinearLayout
                android:id="@+id/cast_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="20dp"
                android:visibility="gone">

                <!-- Header with Red Accent Bar -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="16dp"
                        android:background="#E50914"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CAST &amp; CREW"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_cast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:scrollbars="none" />

            </LinearLayout>

            <!-- Zubflix Info Footer Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/bg_zubflix_info_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZUBFLIX"
                    android:textColor="#E50914"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stream your favorite movies and TV series in stunning high definition. Experience seamless playback, multi-source stream aggregation, and personalized recommendations curated just for you."
                    android:textColor="#9EADC4"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Modern HomeFlix TV Compose Details View Container -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_details_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
