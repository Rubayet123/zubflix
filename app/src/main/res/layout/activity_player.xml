<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ExoPlayer View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:controller_layout_id="@layout/custom_player_control_view"
        app:animation_enabled="false"
        app:show_timeout="5000"
        app:resize_mode="fit"/>

    <!-- Central Buffering / Loading Indicator -->
    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="#E50914" />

        <TextView
            android:id="@+id/tv_loading_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowRadius="3.0"
            android:text="Buffering..."/>
    </LinearLayout>

    <!-- Central Feedback (Double Tap Speed / Seek) -->
    <FrameLayout
        android:id="@+id/centralFeedbackContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_circle_button"
        android:backgroundTint="#AA000000"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_centralFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="2x Speed"/>
    </FrameLayout>

    <!-- Volume Overlay (Right Side Slim Bar) -->
    <LinearLayout
        android:id="@+id/volumeSliderContainer"
        android:layout_width="48dp"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:layout_marginEnd="32dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_volume_speaker"
            app:tint="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <ProgressBar
            android:id="@+id/volumeSlider"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="8dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:progressDrawable="@drawable/vertical_progress_red"
            android:max="100"/>

        <TextView
            android:id="@+id/volumePercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:text="50%"/>
    </LinearLayout>

    <!-- Brightness Overlay (Left Side Slim Bar) -->
    <LinearLayout
        android:id="@+id/brightnessSliderContainer"
        android:layout_width="48dp"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:layout_marginStart="32dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_brightness_sun"
            app:tint="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <ProgressBar
            android:id="@+id/brightnessSlider"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="8dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:progressDrawable="@drawable/vertical_progress_red"
            android:max="100"/>

        <TextView
            android:id="@+id/brightnessPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:text="50%"/>
    </LinearLayout>

    <!-- Playback Statistics Overlay (Stats for Nerds style) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/statsContainer"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="#CC141414"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Playback Stats"
                android:textColor="#E50914"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Resolution:"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tv_stats_resolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1920x1080 @ 30fps"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Codec:"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tv_stats_codec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="video/avc (Hardware)"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Bitrate:"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tv_stats_bitrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4500 kbps"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Buffer Health:"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tv_stats_buffer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="24.2s"
                    android:textColor="#00FF00"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Net Speed:"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tv_stats_speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="18.5 Mbps"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Dropped Frm:"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tv_stats_dropped"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Sidebar Scrim Overlay -->
    <View
        android:id="@+id/sidebarScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Netflix-Style Audio & Subtitles Right Sidebar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sidebarContainer"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:background="#F0141414"
        android:elevation="12dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header -->
        <TextView
            android:id="@+id/tv_sidebar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio &amp; Subtitles"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <ImageButton
            android:id="@+id/btn_close_sidebar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Columns Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            app:layout_constraintTop_toBottomOf="@id/tv_sidebar_title"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Audio Column (Left) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AUDIO"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="12dp"/>

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/audioTracksContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="24dp"
                android:background="#33FFFFFF" />

            <!-- Subtitles Column (Right) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SUBTITLES"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="12dp"/>

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/subtitleTracksContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>

        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sources Sidebar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sourceSidebarContainer"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:background="#F0141414"
        android:elevation="12dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header -->
        <TextView
            android:id="@+id/tv_source_sidebar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sources"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <ImageButton
            android:id="@+id/btn_close_source_sidebar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Scraper Filter Tabs -->
        <HorizontalScrollView
            android:id="@+id/scroll_source_sidebar_filter_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_source_sidebar_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/layout_source_sidebar_filter_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- Sources List -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="12dp"
            app:layout_constraintTop_toBottomOf="@id/scroll_source_sidebar_filter_tabs"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:id="@+id/sourcesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
