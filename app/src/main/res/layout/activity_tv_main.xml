<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tv_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0C10">

    <!-- Fullscreen Dynamic Backdrop Art -->
    <ImageView
        android:id="@+id/tv_hero_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.85"
        android:contentDescription="Hero Backdrop" />

    <!-- Left to Right Cinematic Scrim (Focused strictly on left for text legibility) -->
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_hero_gradient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.62"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Bottom to Top Cinematic Scrim for Rows Clarity (Only bottom half) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_tv_hero_bottom_gradient"
        app:layout_constraintHeight_percent="0.55"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Left Sidebar Navigation Rail -->
    <LinearLayout
        android:id="@+id/tv_sidebar_rail"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:background="#120D0E12"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- App Logo / Red Z icon -->
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_hero_badge_z"
            android:text="Z"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:gravity="center"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="28dp" />

        <!-- 1. Search -->
        <FrameLayout
            android:id="@+id/btn_tv_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tv_sidebar_item_focus"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Search">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search"
                app:tint="#D0D3D9" />
        </FrameLayout>

        <!-- 2. Home -->
        <FrameLayout
            android:id="@+id/btn_tv_home"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tv_sidebar_item_focus"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Home">

            <ImageView
                android:id="@+id/iv_tv_home"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_home"
                app:tint="#E50914" />
        </FrameLayout>

        <!-- 3. Provider Selector -->
        <FrameLayout
            android:id="@+id/btn_tv_provider"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tv_sidebar_item_focus"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Switch Provider">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_network"
                app:tint="#D0D3D9" />
        </FrameLayout>

        <!-- 4. My List -->
        <FrameLayout
            android:id="@+id/btn_tv_mylist"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tv_sidebar_item_focus"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="My List">

            <ImageView
                android:id="@+id/iv_tv_mylist"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_heart"
                android:tint="#D0D3D9"
                app:tint="#D0D3D9" />
        </FrameLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 5. Settings -->
        <FrameLayout
            android:id="@+id/btn_tv_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_tv_sidebar_item_focus"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Settings">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                app:tint="#D0D3D9" />
        </FrameLayout>

    </LinearLayout>

    <!-- Main TV Content Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_main_content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@id/tv_sidebar_rail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Top Right Active Provider Indicator Chip -->
        <LinearLayout
            android:id="@+id/tv_active_provider_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="36dp"
            android:background="@drawable/bg_source_selector"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#00E676"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_active_provider_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuvio Streams"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Top Hero Details Section (Netflix Inspired - Strictly Left-Aligned 46% Column) -->
        <LinearLayout
            android:id="@+id/tv_hero_details_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.46"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Brand Pre-Title Tag (e.g. ZUBFLIX SERIES / MOVIE) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_tv_card_brand_badge"
                    android:text="Z"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tv_hero_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="SERIES"
                    android:textColor="#D0D5DD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />
            </LinearLayout>

            <!-- Hero Title -->
            <TextView
                android:id="@+id/tv_hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Featured Title"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Metadata Line (Dot-separated & Outlined Badges) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Year -->
                <TextView
                    android:id="@+id/tv_hero_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2025"
                    android:textColor="#C4C8D0"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Dot Divider -->
                <TextView
                    android:id="@+id/tv_hero_dot_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text="•"
                    android:textColor="#707684"
                    android:textSize="12sp" />

                <!-- Episodes or Type -->
                <TextView
                    android:id="@+id/tv_hero_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Series"
                    android:textColor="#C4C8D0"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Spec 2: 5.1 Audio -->
                <TextView
                    android:id="@+id/tv_hero_badge_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tv_spec_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="5.1"
                    android:textColor="#D8DCF0"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Rating Outlined Badge -->
                <LinearLayout
                    android:id="@+id/tv_hero_rating_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tv_spec_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_star"
                        app:tint="#FFD700" />

                    <TextView
                        android:id="@+id/tv_hero_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="8.5"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hero Synopsis (Clean 3-line description on left side) -->
            <TextView
                android:id="@+id/tv_hero_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="480dp"
                android:text="Movie description synopsis goes here..."
                android:textColor="#C0C5D0"
                android:textSize="12.5sp"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:ellipsize="end" />

            <!-- Netflix-Style Contextual Highlight Tagline -->
            <LinearLayout
                android:id="@+id/tv_hero_highlight_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_source_selector"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_movie"
                    app:tint="#E50914" />

                <TextView
                    android:id="@+id/tv_hero_highlight_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Top 10 Trending • Stream instantly"
                    android:textColor="#E0E3EA"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Leanback Rows Container Fragment Frame -->
        <FrameLayout
            android:id="@+id/tv_rows_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_hero_details_layout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/tv_loading_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#E50914"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
