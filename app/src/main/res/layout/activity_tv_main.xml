<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tv_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0C10">

    <!-- Fullscreen Dynamic Backdrop Art -->
    <ImageView
        android:id="@+id/tv_hero_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.85"
        android:contentDescription="Hero Backdrop" />

    <!-- Left to Right Cinematic Scrim (Focused strictly on left for text legibility) -->
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_hero_gradient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.62"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Bottom to Top Cinematic Scrim for Rows Clarity (Only bottom half) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_tv_hero_bottom_gradient"
        app:layout_constraintHeight_percent="0.55"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Left Sidebar Navigation Rail -->
    <LinearLayout
        android:id="@+id/tv_sidebar_rail"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:background="#120D0E12"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- App Logo / Netflix-Style 3D Ribbon Z icon -->
        <ImageView
            android:id="@+id/tv_sidebar_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_tv_brand_logo"
            android:contentDescription="Zubflix"
            android:layout_marginBottom="26dp" />

        <!-- 1. Search -->
        <FrameLayout
            android:id="@+id/btn_tv_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tv_sidebar_item_focus"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Search">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search"
                app:tint="#D0D3D9" />
        </FrameLayout>

        <!-- 2. Home -->
        <FrameLayout
            android:id="@+id/btn_tv_home"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tv_sidebar_item_focus"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Home">

            <ImageView
                android:id="@+id/iv_tv_home"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_home"
                app:tint="#E50914" />
        </FrameLayout>

        <!-- 3. Provider Selector -->
        <FrameLayout
            android:id="@+id/btn_tv_provider"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tv_sidebar_item_focus"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Switch Provider">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_network"
                app:tint="#D0D3D9" />
        </FrameLayout>

        <!-- 4. My List -->
        <FrameLayout
            android:id="@+id/btn_tv_mylist"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tv_sidebar_item_focus"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="My List">

            <ImageView
                android:id="@+id/iv_tv_mylist"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_heart"
                app:tint="#D0D3D9" />
        </FrameLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 5. Settings -->
        <FrameLayout
            android:id="@+id/btn_tv_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_tv_sidebar_item_focus"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Settings">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                app:tint="#D0D3D9" />
        </FrameLayout>

    </LinearLayout>

    <!-- Main TV Content Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_main_content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@id/tv_sidebar_rail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Top Right Active Provider Indicator Chip -->
        <LinearLayout
            android:id="@+id/tv_active_provider_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="36dp"
            android:background="@drawable/bg_source_selector"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#00E676"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_active_provider_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuvio Streams"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Top Hero Details Section (Netflix Inspired - Strictly Left-Aligned 48% Column) -->
        <LinearLayout
            android:id="@+id/tv_hero_details_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.48"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Brand Pre-Title Tag (e.g. ZUBFLIX SERIES / MOVIE) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_tv_brand_logo"
                    android:contentDescription="Zubflix Original" />

                <TextView
                    android:id="@+id/tv_hero_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="SERIES"
                    android:textColor="#D0D5DD"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />
            </LinearLayout>

            <!-- Hero Title -->
            <TextView
                android:id="@+id/tv_hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Featured Title"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Metadata Line (Dot-separated & Outlined Badges) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Year -->
                <TextView
                    android:id="@+id/tv_hero_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2025"
                    android:textColor="#C4C8D0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Dot Divider -->
                <TextView
                    android:id="@+id/tv_hero_dot_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:text="•"
                    android:textColor="#707684"
                    android:textSize="11sp" />

                <!-- Episodes or Type -->
                <TextView
                    android:id="@+id/tv_hero_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Series"
                    android:textColor="#C4C8D0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Spec 2: 5.1 Audio -->
                <TextView
                    android:id="@+id/tv_hero_badge_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tv_spec_badge"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:text="5.1"
                    android:textColor="#D8DCF0"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <!-- Rating Outlined Badge -->
                <LinearLayout
                    android:id="@+id/tv_hero_rating_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tv_spec_badge"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:src="@drawable/ic_star"
                        app:tint="#FFD700" />

                    <TextView
                        android:id="@+id/tv_hero_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="8.5"
                        android:textColor="#FFFFFF"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hero Synopsis (Clean 2-line description on left side) -->
            <TextView
                android:id="@+id/tv_hero_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxWidth="460dp"
                android:text="Movie description synopsis goes here..."
                android:textColor="#B0B6C2"
                android:textSize="11.5sp"
                android:lineSpacingExtra="1.5dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Disney+ / HBO Max Transparent Editorial Accent Line -->
            <LinearLayout
                android:id="@+id/tv_hero_highlight_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="3dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_editorial_accent_bar" />

                <TextView
                    android:id="@+id/tv_hero_highlight_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="TOP RATED • 4K ULTRA HD • 5.1 AUDIO"
                    android:textColor="#D1D5DB"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </LinearLayout>

        </LinearLayout>

        <!-- Horizontal Guideline for Content Rows Anchor (Netflix Hero Split) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/tv_rows_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.52" />

        <!-- Leanback Rows Container Fragment Frame -->
        <FrameLayout
            android:id="@+id/tv_rows_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/tv_rows_guideline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Branded Startup Splash Overlay -->
        <LinearLayout
            android:id="@+id/tv_splash_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0B0C0F"
            android:gravity="center"
            android:orientation="vertical"
            android:elevation="30dp"
            android:clickable="false"
            android:focusable="false">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Zubflix Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="ZUBFLIX"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.15" />

            <ProgressBar
                android:id="@+id/tv_loading_indicator"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="28dp"
                android:indeterminateTint="#E50914" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
