<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_item_focus"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/tv_rank"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="#1"
        android:textColor="#FFD700"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#22FFD700"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CTG Movies Scraper"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High speed BDIX scraper"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_move_up"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="▲"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="0dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_move_down"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="▼"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="0dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginEnd="8dp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>

</LinearLayout>
