<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="0dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_stream_card_selector"
    android:clickable="true"
    android:focusable="true">

    <!-- Left Accent Indicator Bar -->
    <View
        android:id="@+id/view_accent_bar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#E50914"
        android:backgroundTint="#E50914"/>

    <!-- Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <!-- Top Row: Index Badge + Addon Provider + Moniker + Metadata Pills -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:id="@+id/badges_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Sequential Index Badge (01, 02...) -->
                <TextView
                    android:id="@+id/tv_stream_index"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_stream_index_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="6dp"/>

                <!-- Addon Provider Name Badge -->
                <TextView
                    android:id="@+id/tv_addon_provider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Torrentio"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_nuvio_badge"
                    android:backgroundTint="#2E1C42"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="6dp"/>

                <!-- RD+ or Torrent Moniker Badge -->
                <TextView
                    android:id="@+id/tv_moniker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[RD+]"
                    android:textColor="#00D2FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_nuvio_badge"
                    android:backgroundTint="#05203C"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"/>

                <!-- Resolution Badge (4K, 1080p, 720p, etc.) -->
                <TextView
                    android:id="@+id/tv_badge_resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1080p"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_nuvio_badge"
                    android:backgroundTint="#E50914"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone"/>

                <!-- File Size Badge (e.g. 2.32 GB) -->
                <TextView
                    android:id="@+id/tv_badge_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.32 GB"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_nuvio_badge"
                    android:backgroundTint="#1B4D22"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone"/>

                <!-- Quality Badge (BluRay, WEBRip, CAM, etc.) -->
                <TextView
                    android:id="@+id/tv_badge_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAM"
                    android:textColor="#D1D1D1"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_nuvio_badge"
                    android:backgroundTint="#333333"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone"/>

                <!-- Codec Badge (HEVC, x265, h264) -->
                <TextView
                    android:id="@+id/tv_badge_codec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEVC"
                    android:textColor="#C1C1C1"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_nuvio_badge"
                    android:backgroundTint="#333333"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone"/>

                <!-- Audio Badge (Atmos, DD 5.1) -->
                <TextView
                    android:id="@+id/tv_badge_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atmos"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_nuvio_badge"
                    android:backgroundTint="#3F1B63"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Bottom Row: Torrent File / Stream Title -->
        <TextView
            android:id="@+id/tv_torrent_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Spider-Man: Brand New Day (2026)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"/>

    </LinearLayout>

</LinearLayout>
