<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid base background to prevent any background content from shining through at the top -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF08090C"
                android:endColor="#FA08090C" />
        </shape>
    </item>
    <!-- Border ONLY at the bottom to define the navbar edge beautifully -->
    <item android:top="-2dp" android:left="-2dp" android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#15FFFFFF" />
        </shape>
    </item>
</layer-list>
