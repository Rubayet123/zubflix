<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid base background to prevent background content from making the text unreadable -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#FF08090C"
                android:endColor="#FA08090C" />
        </shape>
    </item>
    <!-- Border ONLY at the top to define the navbar edge beautifully -->
    <item android:bottom="-2dp" android:left="-2dp" android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#15FFFFFF" />
        </shape>
    </item>
</layer-list>
