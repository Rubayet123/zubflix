<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3D181B"/>
            <stroke android:width="2.5dp" android:color="#E50914"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2D1215"
                android:endColor="#1F0D0F" />
            <stroke android:width="1.5dp" android:color="#E50914"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</selector>
