<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#282C3A"/>
            <stroke android:width="2dp" android:color="#E50914"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#222530"/>
            <stroke android:width="1.5dp" android:color="#E50914"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181B22"/>
            <stroke android:width="1dp" android:color="#22FFFFFF"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</selector>
