<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#242B35"/>
            <stroke android:width="2.5dp" android:color="#E50914"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E232B"/>
            <stroke android:width="2dp" android:color="#E50914"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#161B22"/>
            <stroke android:width="1dp" android:color="#30363D"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</selector>
